{
  "name": "garmin-slack-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Posts your Garmin Connect activities to a Slack channel (Personal API). Zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "validate": "prettier --check . && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.0",
    "prettier": "^3.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
